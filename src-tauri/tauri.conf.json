{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AutoAgents",
  "version": "0.4.0",
  "identifier": "com.tianlong.autoagents",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist",
    "additionalWatchFolders": ["../crates"]
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AutoAgents — 多机 Agent 管理与协同工作台",
        "width": 1360,
        "height": 860,
        "minWidth": 1000,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "macOS": {
      "signingIdentity": "-",
      "hardenedRuntime": false
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
